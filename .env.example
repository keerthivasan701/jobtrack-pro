# ==============================================================================
# JobTrack Pro — Environment Configuration
# ==============================================================================

# Backend Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-with-your-production-secret-key-here-xyz
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# For local dev without MySQL, omit or comment out DB_ENGINE to use SQLite default.
# For MySQL:
DB_ENGINE=mysql
DB_NAME=jobtrack_pro
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Security
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Settings (frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
